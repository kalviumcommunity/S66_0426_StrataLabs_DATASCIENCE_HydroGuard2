   "source": [
    "# Unit 4.17: Iterative Data Processing\n",
    "\n",
    "Use loops for repeated rainfall calculations over months and records."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "values = [210, 320, 295, 260]\n",
    "cumulative = []\n",
    "current = 0\n",
    "for value in values:\n",
    "    current += value\n",
    "    cumulative.append(current)\n",
    "cumulative"
   ]
  }
